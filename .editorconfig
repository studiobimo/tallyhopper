root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,json5,toml,mcmeta}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
# List continuation and nested content follow Markdown, not code, indentation.
indent_size = unset

[*.bat]
end_of_line = crlf

[Makefile]
indent_style = tab

[gradle/wrapper/gradle-wrapper.jar]
charset = unset
end_of_line = unset
insert_final_newline = unset
