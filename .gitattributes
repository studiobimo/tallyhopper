# >>> template:base
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.zip  binary
# <<< template:base

*.cmd  text eol=crlf

# >>> template:gradle
# The wrapper scripts are stored exactly as Gradle ships them: gradlew.bat with CRLF, gradlew with
# LF. If git converted them, the blob Dependabot commits on a wrapper bump would never match the
# repository's, and every check that compares the tree would report gradlew.bat as changed.
*.bat    -text
gradlew  text eol=lf
# <<< template:gradle

*.jar  binary
*.ogg  binary
*.nbt  binary

# Datagen output: collapse in PR diffs
common/src/generated/** linguist-generated=true
